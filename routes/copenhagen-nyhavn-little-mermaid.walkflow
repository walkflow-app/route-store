  "name": {
    "en": "Nyhavn to the Little Mermaid",
    "de": "Von Nyhavn zur Kleinen Meerjungfrau",
    "fr": "De Nyhavn à la Petite Sirène",
    "uk": "Від Ньюгавна до Русалоньки"
  },
  "place": {
    "en": "Copenhagen, Denmark",
    "de": "Kopenhagen, Dänemark",
    "fr": "Copenhague, Danemark",
    "uk": "Копенгаген, Данія"
  },
