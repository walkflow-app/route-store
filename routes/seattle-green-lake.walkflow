  "name": {
    "en": "Green Lake Loop",
    "de": "Green-Lake-Runde",
    "fr": "Tour de Green Lake",
    "uk": "Коло озера Грін-Лейк"
  },
  "place": {
    "en": "Seattle, USA",
    "de": "Seattle, USA",
    "fr": "Seattle, États-Unis",
    "uk": "Сіетл, США"
