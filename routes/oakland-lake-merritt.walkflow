  "name": {
    "en": "Lake Merritt Loop",
    "de": "Lake-Merritt-Runde",
    "fr": "Tour du lac Merritt",
    "uk": "Коло озера Мерритт"
  },
  "place": {
    "en": "Oakland, USA",
    "de": "Oakland, USA",
    "fr": "Oakland, États-Unis",
