  "name": {
    "en": "Lake Bled Loop",
    "de": "Bleder-See-Runde",
    "fr": "Tour du lac de Bled",
    "uk": "Коло Блейського озера"
  },
  "place": {
    "en": "Bled, Slovenia",
    "de": "Bled, Slowenien",
    "fr": "Bled, Slovénie",
    "uk": "Блед, Словенія"
  },
