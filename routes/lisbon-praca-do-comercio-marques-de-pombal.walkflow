  "name": {
    "en": "Praça do Comércio to Marquês de Pombal",
    "de": "Von der Praça do Comércio zur Praça Marquês de Pombal",
    "fr": "De la Praça do Comércio à la Praça Marquês de Pombal",
    "uk": "Від Праса-ду-Комерсіу до площі Маркіза де Помбала"
  },
  "place": {
    "en": "Lisbon, Portugal",
